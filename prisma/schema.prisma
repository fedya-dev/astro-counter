// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A registered site whose visits we are tracking.
// Each site gets a public `slug` (used in the tracking snippet) and
// a private `apiKey` (used by the snippet to authenticate the POST).
// The apiKey is rotated by the owner only.
model Site {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  apiKey    String   @unique
  // Hex color for the chip in the site selector (e.g. "#a855f7").
  // Auto-assigned from a palette if not specified.
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits    Visit[]
}

// A single tracked visit. We store the IP + user-agent hash so we can
// deduplicate visits per day (one visitor = one count per day per site).
model Visit {
  id          String   @id @default(cuid())
  visitorHash String
  date        String
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  country     String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([siteId, date])
  @@index([visitorHash, siteId, date])
}
